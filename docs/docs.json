{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Juno",
  "description": "Bits of Good's shared infrastructure API.",
  "colors": {
    "primary": "#1F6FEB",
    "light": "#5B9BFF",
    "dark": "#0B3D91"
