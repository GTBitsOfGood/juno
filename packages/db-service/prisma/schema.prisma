// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  //url = "postgresql://johndoe:mysecretpassword@localhost:5432"
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String
  password        String
  type            Role
  allowedProjects Project[]
}

model Project {
  id           Int                  @id @default(autoincrement())
  name         String               @unique
  apiKeys      ApiKey[]
  users        User[]
  emailService EmailServiceConfig[]
  fileService  FileServiceConfig[]
  analyticsService AnalyticsServiceConfig[]
}

model ApiKey {
  id          Int        @id @default(autoincrement())
  hash        String     @unique
  scopes      ApiScope[]
  description String
  projectId   Int
  project     Project    @relation(fields: [projectId], references: [id])
  environment String
  createdAt   DateTime @default(now())
}

enum ApiScope {
  FULL
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}

model AnalyticsServiceConfig {
  id Int
  environment String @default("test")
  serverAnalyticsKey String @default("")
  clientAnalyticsKey String @default("")
  Project Project @relation(fields: [id], references: [id])
  @@id([id, environment])
}

model EmailServiceConfig {
  id             Int
  environment    String @default("test")
  sendgridApiKey String @default("")
  emails         EmailServiceConfigAndSender[]
  domains        EmailServiceConfigAndDomain[]
  verifiedSenders EmailVerifiedSender[]
  Project        Project                       @relation(fields: [id], references: [id])

  @@id([id, environment])
}

model EmailServiceConfigAndSender {
  config    EmailServiceConfig @relation(fields: [configId, configEnv], references: [id, environment])
  configId  Int // relation scalar field (used in the `@relation` attribute above)
  configEnv String
  sender    EmailSender        @relation(fields: [username, domain], references: [username, domain])
  username  String
  domain    String

  @@id([configId, configEnv, username, domain])
}

model EmailServiceConfigAndDomain {
  config    EmailServiceConfig @relation(fields: [configId, configEnv], references: [id, environment])
  configId  Int // relation scalar field (used in the `@relation` attribute above)
  configEnv String
  domain    EmailDomain        @relation(fields: [domainStr], references: [domain])
  domainStr String
  // SendGrid's id for this domain in this project/environment's SendGrid
  // account. Authoritative over EmailDomain.sendgridId, which only holds the
  // id from the first registration of the domain name.
  sendgridId Int @default(0)

  @@id([configId, configEnv, domainStr])
}

// A SendGrid verified sender registered through Juno for a project/environment.
// getSenders only returns senders recorded here.
model EmailVerifiedSender {
  config     EmailServiceConfig @relation(fields: [configId, configEnv], references: [id, environment])
  configId   Int
  configEnv  String
  sendgridId Int
  fromEmail  String

  @@id([configId, configEnv, sendgridId])
}

model EmailSender {
  username        String
  domain          String
  domainItem      EmailDomain                   @relation(fields: [domain], references: [domain])
  description     String? // Optional metadata/description field
  attachedConfigs EmailServiceConfigAndSender[]

  @@id([username, domain])
}

model EmailDomain {
  domain          String                        @id()
  subdomain       String?
  sendgridId      Int
  attachedConfigs EmailServiceConfigAndDomain[]
  EmailSender     EmailSender[]
}

enum FileProviderType {
  S3 
  AZURE 
}

model FileServiceConfig {
  id              Int                 
  environment    String @default("test")
  buckets         FileServiceBucket[]
  providers       FileProvider[]
  Project         Project             @relation(fields: [id], references: [id])
  FileServiceFile FileServiceFile[]
  @@id([id, environment])
}

model FileProvider {
  id                Int                 @id @default(autoincrement())
  name              String
  accessKey         String
  metadata          String
  type              FileProviderType
  // The file config that owns this provider. Nullable only so providers that
  // no bucket used before per-config scoping survive the migration; every
  // provider created since is linked to a config.
  configId          Int?
  configEnv         String?
  config            FileServiceConfig?  @relation(fields: [configId, configEnv], references: [id, environment], onDelete: Cascade)
  FileServiceBucket FileServiceBucket[]

  @@unique([name, configId, configEnv])
}

model FileServiceBucket {
  name             String
  // A bucket can only use a provider from its own file config.
  provider         FileProvider      @relation(fields: [fileProviderName, configId, configEnv], references: [name, configId, configEnv])
  configId         Int
  configEnv        String
  config           FileServiceConfig @relation(fields: [configId, configEnv], references: [id, environment])
  fileProviderName String
  FileServiceFile  FileServiceFile[]

  @@id([name, configId, configEnv])
}

model FileServiceFile {
  path       String
  bucket     FileServiceBucket @relation(fields: [bucketName, configId, configEnv], references: [name, configId, configEnv])
  config     FileServiceConfig @relation(fields: [configId, configEnv], references: [id, environment])
  configId   Int
  configEnv  String
  bucketName String
  metadata   String

  @@id([path, bucketName, configId, configEnv])
}

model NewAccountRequest {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String
  password    String
  userType    Role
  projectName String?
  createdAt   DateTime @default(now())
}

enum AnalyticsEventType {
  CLICK
  VISIT
  INPUT
  CUSTOM
}

model AnalyticsEvent {
  id          Int                @id @default(autoincrement())
  projectId   Int
  environment String
  type        AnalyticsEventType
  category    String
  subcategory String
  properties  Json               @default("{}")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([projectId, environment, type, createdAt(sort: Desc), id(sort: Desc)], name: "analytics_event_pagination_idx")
}
